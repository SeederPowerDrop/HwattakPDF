"help.topic.start.title" = "Erste Schritte";
"help.topic.start.summary" = "Öffne PDFs und lerne den Hauptarbeitsbereich kennen.";
"help.item.open.title" = "PDF öffnen";
"help.item.open.detail" = "Verwende das Ordnersymbol oder ⌘O. Wenn du mehrere PDFs auswählst, wird jedes in einem eigenen Tab geöffnet.";
"help.item.layout.title" = "Bildschirmaufbau verstehen";
"help.item.layout.detail" = "Die obere Leiste verwaltet Arbeitsbereiche, Tabs, Vergleiche und Ressourcen. Die Werkzeugleiste darunter steuert Seiten, Ansichten, Bearbeitung, OCR, KI und Suche.";
"help.item.resume.title" = "Arbeit fortsetzen";
"help.item.resume.detail" = "Nach einem normalen Beenden werden Dateien, Arbeitsbereiche, Tab-Reihenfolge und -Stapel, aktive Seiten, Ansichtsstatus und Vergleichslayout wiederhergestellt. PDF-Änderungen müssen trotzdem gespeichert werden.";

"help.topic.tabs.title" = "Tabs, Stapel und Arbeitsbereiche";
"help.topic.tabs.summary" = "Organisiere viele Dokumente, ohne ihren jeweiligen Zustand zu verlieren.";
"help.item.tab_stack.title" = "Tab-Stapel erstellen und neu anordnen";
"help.item.tab_stack.detail" = "Lege einen Tab in der Mitte eines anderen ab, um beide zu stapeln. Lege ihn nahe einem Rand ab, um stattdessen die Reihenfolge zu ändern.";
"help.item.unstack.title" = "Tab aus einem Stapel lösen";
"help.item.unstack.detail" = "Ziehe einen gestapelten Tab an das Ende der primären Tab-Leiste, um ihn eigenständig zu machen, oder lege ihn im Dokumentbereich ab, um genau diese Sitzung in ein neues HwattakPDF-Fenster zu verschieben.";
"help.item.workspace.title" = "Getrennte Arbeitsbereiche";
"help.item.workspace.detail" = "Über das Menü mit den gestapelten Quadraten kannst du Arbeitsbereiche erstellen, umbenennen, wechseln oder löschen und zugehörige Tabs gemeinsam verschieben.";
"help.item.resources.title" = "Ressourcennutzung beobachten";
"help.item.resources.detail" = "Das Messinstrument-Symbol zeigt CPU, Arbeitsspeicher und geschätzte Last pro Tab. Unveränderte inaktive PDFs werden bei Bedarf automatisch in den Ruhezustand versetzt.";

"help.topic.view.title" = "Seiten, Zoom und Navigation";
"help.topic.view.summary" = "Wähle ein Leselayout und bewege dich bequem durch das Dokument.";
"help.item.page_panel.title" = "Seitenleiste anzeigen und platzieren";
"help.item.page_panel.detail" = "Das Leistensymbol blendet Miniaturen ein oder aus. Mit dem Symbol für vier Richtungen platzierst du die Leiste links, rechts, oben oder unten.";
"help.item.page_layout.title" = "Anzahl der angezeigten Seiten wählen";
"help.item.page_layout.detail" = "Das Hochformatsymbol zeigt eine Seite. Das Symbol mit einer angeschnittenen Doppelseite darunter aktiviert fortlaufendes Scrollen mit zwei Seiten; das Symbol mit genau zwei Seiten zeigt nur die aktuelle Doppelseite und wechselt jeweils um zwei Seiten. Das Vier-Seiten-Symbol und das Richtungsmenü steuern Vierergruppen; über das Zahlensymbol sind 1 bis 12 Seiten möglich.";
"help.item.zoom_pan.title" = "Zoomen und verschieben";
"help.item.zoom_pan.detail" = "Zoome mit der Aufziehgeste und scrolle wie gewohnt mit zwei Fingern. Standardmäßig hältst du die Wahltaste gedrückt und scrollst zum Zoomen: In der Ein- und Zweiseitenansicht bleibt der Zeiger verankert, die Mehrseitenübersicht verwendet ihre Mitte. Halte die Umschalttaste und scrolle vertikal, um horizontal zu verschieben. In den Einstellungen lässt sich die Zoomtaste auf Befehlstaste oder Aus ändern.";
"help.item.thumbnails.title" = "Miniaturgruppen anpassen";
"help.item.thumbnails.detail" = "Die Seitenleiste kann einzelne Seiten, feste Links-rechts-Paare oder Vierergruppen anzeigen. Verwende den Regler, die Plus-/Minustasten oder die Vergrößerungsgeste des Trackpads und ziehe eine echte Seitenminiatur, um die Reihenfolge zu ändern.";

"help.topic.compare.title" = "PDFs vergleichen";
"help.topic.compare.summary" = "Lies zwei bis vier geöffnete Dokumente nebeneinander oder untereinander.";
"help.item.compare_start.title" = "Vergleich starten";
"help.item.compare_start.detail" = "Öffne mindestens zwei PDFs, wähle dann das Symbol mit den überlappenden Rechtecken und die zu vergleichenden Dokumente aus.";
"help.item.compare_layout.title" = "Bereiche neu anordnen und ihre Größe ändern";
"help.item.compare_layout.detail" = "Wähle eine Anordnung nebeneinander oder untereinander. Ziehe den Kopfbereich, um einen Bereich neu anzuordnen, und die Trennlinie, um Breite oder Höhe benachbarter Bereiche anzupassen.";
"help.item.compare_sync.title" = "Bildlauf synchronisieren oder sperren";
"help.item.compare_sync.detail" = "Aktiviere die Bildlaufsynchronisierung, um der relativen Position in den Dokumenten zu folgen. Sperre jeden Bereich, der an seiner Position bleiben soll.";

"help.topic.edit.title" = "Bearbeiten und kommentieren";
"help.topic.edit.summary" = "Füge standardmäßige PDF-Anmerkungen hinzu und verwalte Seiten sicher.";
"help.item.tools.title" = "Auswahl, Text, Stift und Radierer";
"help.item.tools.detail" = "Mit der segmentierten Werkzeugauswahl wechselst du zwischen Objektauswahl, Freitexteingabe, Freihandzeichnung und Radieren. Die detaillierte Bearbeitung steht in der Ein- und Zweiseitenansicht zur Verfügung.";
"help.item.markup.title" = "Hervorheben, unterschreiben und Bilder hinzufügen";
"help.item.markup.detail" = "Wähle PDF-Text aus, bevor du den Textmarker verwendest. Das Signatursymbol öffnet die Trackpad-Erfassung, und das Foto-plus-Symbol platziert ein Bild auf der aktuellen Seite.";
"help.item.pages.title" = "Seiten zusammenstellen";
"help.item.pages.detail" = "Über das Seitenmenü kannst du PDFs zusammenführen, ausgewählte Seiten als eine PDF oder separate PDFs sichern, drehen oder löschen. Miniaturen lassen sich ebenfalls auswählen und zur Neuanordnung ziehen.";
"help.item.ocr.title" = "Lokale OCR ausführen";
"help.item.ocr.detail" = "Die OCR-Taste verwendet Apple Vision auf diesem Mac, kann Seitenprüfpunkte fortsetzen und exportiert eine durchsuchbare Kopie, ohne das PDF an einen Server zu senden.";
"help.item.move_delete.title" = "Hinzugefügte Objekte verschieben oder löschen";
"help.item.move_delete.detail" = "Ziehe hinzugefügten Text, Signaturen oder Bilder mit dem Auswahlwerkzeug. Pfeiltasten verschieben um 1 Punkt, Umschalt+Pfeil um 10 Punkte, Entf löscht und Esc hebt die Auswahl auf. Bilder können außerdem skaliert, zugeschnitten und in ihrer Ebenenreihenfolge geändert werden.";

"help.topic.signature.title" = "Signaturen";
"help.topic.signature.summary" = "Erfasse, speichere und platziere eine saubere handschriftliche Signatur.";
"help.item.signature_capture.title" = "Mit Trackpad oder Maus erfassen";
"help.item.signature_capture.detail" = "Drücke Trackpad-Eingabe starten und zeichne dann mit einem Finger und leichter Berührung. Empfindlichkeit, Glättung, Breite, Geschwindigkeit, Farbe und Mauseingabe lassen sich einstellen.";
"help.item.signature_secure.title" = "Gespeicherte Signatur verwalten";
"help.item.signature_secure.detail" = "Eine erfolgreich angewendete Signatur kann im nicht synchronisierten Schlüsselbund des aktuellen macOS-Benutzers gespeichert werden. Ersetze oder lösche sie in der Verwaltung gespeicherter Signaturen.";
"help.item.signature_place.title" = "Signatur positionieren";
"help.item.signature_place.detail" = "Nach dem Anwenden wird das Auswahlwerkzeug aktiviert. Ziehe die saubere Signatur in ihr Feld und ändere ihre Größe über die Eckpunkte.";

"help.topic.ai.title" = "PDF-KI";
"help.topic.ai.summary" = "Verwende externe KI nur mit ausdrücklich gewähltem Anbieter, Umfang und deiner Zustimmung.";
"help.item.ai_setup.title" = "Anbieter verbinden";
"help.item.ai_setup.detail" = "Wähle in den Einstellungen OpenAI, Claude, Gemini, DeepSeek, Qwen oder einen eigenen kompatiblen Endpunkt, wähle ein Modell aus und speichere dessen API-Schlüssel im Schlüsselbund.";
"help.item.ai_actions.title" = "Aktion und Umfang wählen";
"help.item.ai_actions.detail" = "Die Funkeln-Taste öffnet Zusammenfassung, Analyse, Problemlösung, Ausfüllentwurf, Suche nach verwandten PDFs und Webrecherche für ausgewählten Text, Seiten oder einen repräsentativen Dokumentkontext.";
"help.item.ai_privacy.title" = "Vor dem Senden prüfen";
"help.item.ai_privacy.detail" = "HwattakPDF zeigt vor jeder Anfrage den Text und die Unterhaltung, die den Mac verlassen. Das ursprüngliche PDF wird nicht automatisch hochgeladen; Web- und MCP-Werkzeuge sind optional, und MCP-Aufrufe müssen genehmigt werden.";

"help.topic.save.title" = "Sicher speichern";
"help.topic.save.summary" = "Erkenne, wann die PDF-Datei geändert wird und wann sich die App nur den Arbeitsbereich merkt.";
"help.item.save_choices.title" = "PDF-Änderungen speichern";
"help.item.save_choices.detail" = "Mit ⌘S kannst du das Original überschreiben, eine Kopie speichern oder abbrechen. Die Speichertaste wird hervorgehoben, wenn das aktive PDF ungesicherte Änderungen enthält.";
"help.item.save_copy.title" = "Separate Kopie speichern";
"help.item.save_copy.detail" = "⇧⌘S öffnet direkt Kopie speichern. Das Original bleibt erhalten, und die gespeicherte Kopie wird zum aktuellen unveränderten Dokument.";
"help.item.save_close.title" = "Schließen, ohne Arbeit zu verlieren";
"help.item.save_close.detail" = "Beim Schließen eines geänderten Tabs, Fensters oder der App kannst du überschreiben, eine Kopie speichern, Änderungen verwerfen oder abbrechen. Abbrechen lässt das Dokument geöffnet.";
"help.item.session_vs_pdf.title" = "Sitzungswiederherstellung ist kein PDF-Speichern";
"help.item.session_vs_pdf.detail" = "Tab-Stapel, Arbeitsbereiche, Fenster, Vergleichslayout, Seiten und Ansichtspositionen werden automatisch gespeichert. Anmerkungs- und Seitenänderungen gelangen erst nach dem Speichern in die PDF-Datei.";

"help.topic.shortcuts.title" = "Tastaturkurzbefehle";
