"help.topic.plugins.title" = "Erweiterungen";
"help.topic.plugins.summary" = "Füge benötigte Funktionen sicher hinzu und verwalte Berechtigungen und Ressourcennutzung.";
"help.item.plugin_install.title" = "Installation und Verwaltung";
"help.item.plugin_install.detail" = "Öffne in der Menüleiste Erweiterungen > Erweiterungen verwalten… und wähle unter Erweiterung installieren… ein .hwattakplugin-Ordnerpaket aus. Prüfe vor der Installation Name, Autor, Version und angeforderte Berechtigungen. Anschließend kannst du die Erweiterung mit dem Schalter aktivieren oder deaktivieren beziehungsweise entfernen.";
"help.item.plugin_permissions.title" = "Minimale Berechtigungen prüfen";
"help.item.plugin_permissions.detail" = "V1-Berechtigungen sind auf Dokumentinformationen, ausgewählten Text, Zwischenablage und bestätigte externe Links begrenzt. V2 weist Zugriff auf aktuellen Seitentext, Übersetzung, YouTube oder Webpanel getrennt aus. Installiere keine Erweiterung mit zweckfremden Berechtigungen.";
"help.item.plugin_safety.title" = "Sicherheits- und Vertrauensgrenze";
"help.item.plugin_safety.detail" = "V1-Erweiterungen verwenden validierte deklarative Vorlagen und greifen nicht direkt auf beliebigen Code, Shells, Schlüsselbund, PDF-Rohbytes, Netzwerk oder GPU zu. V2-Webpanels zeigen geprüfte externe Seiten in temporären Sitzungen; JavaScript, Cookies, Tracking und Unterressourcenanfragen können jedoch laufen. Die Navigationsrichtlinie ist kein Tracker-Blocker oder Firewall.";
"help.item.plugin_performance.title" = "Leistung und Problembehebung";
"help.item.plugin_performance.detail" = "Es gelten Grenzen von 32 Erweiterungen, 24 Aktionen pro Erweiterung und 2 MB pro Paket. Sie laufen nur bei Bedarf und erzeugen im Normalbetrieb keine CPU- oder GPU-Last. Wenn die App langsamer wird oder Fehler wiederholt auftreten, deaktiviere die Erweiterung, aktualisiere die Liste und prüfe dann die Meldung zum Paket in Quarantäne oder entferne die Erweiterung.";

