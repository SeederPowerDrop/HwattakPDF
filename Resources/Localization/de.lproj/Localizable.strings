"help.title" = "HwattakPDF-Benutzerhandbuch";
"help.menu" = "HwattakPDF-Benutzerhandbuch";
"help.subtitle" = "Lerne Symbole, Gesten, Kurzbefehle und sichere Arbeitsabläufe für Dokumente kennen.";
"help.search" = "Funktionen oder Kurzbefehle suchen";
"help.no_results.title" = "Keine Ergebnisse";
"help.no_results.detail" = "Versuche es mit einem anderen Funktionsnamen oder Tastaturkurzbefehl.";
"help.hover_tip" = "Tipp: Bewege den Zeiger über ein Symbol in der Werkzeugleiste, um seinen Namen und Zweck zu sehen.";
