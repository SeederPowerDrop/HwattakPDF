"help.item.layout.title" = "Know the screen";
"help.item.layout.detail" = "The top bar manages workspaces, tabs, comparison, and resources. The toolbar below controls pages, views, editing, OCR, AI, and search.";
"help.item.resume.title" = "Resume your work";
"help.item.resume.detail" = "Files, workspaces, tab order and stacks, active pages, view state, and comparison layout return after a normal quit. PDF edits still need to be saved.";

"help.topic.tabs.title" = "Tabs, Stacks & Workspaces";
"help.topic.tabs.summary" = "Organize many documents without losing their individual state.";
"help.item.tab_stack.title" = "Create and rearrange a tab stack";
"help.item.tab_stack.detail" = "Drop a tab onto the center of another tab to stack them. Drop near an edge to reorder instead.";
"help.item.unstack.title" = "Take a tab out";
"help.item.unstack.detail" = "Drag a stacked tab to the end of the primary tab row to make it standalone, or drop it in the document area to move the exact session into a new HwattakPDF window.";
"help.item.workspace.title" = "Separate workspaces";
"help.item.workspace.detail" = "Use the stacked-squares menu to create, rename, switch, or delete workspaces and move related tabs together.";
"help.item.resources.title" = "Watch resource use";
"help.item.resources.detail" = "The gauge icon opens CPU, memory, and per-tab load estimates. Clean inactive PDFs hibernate automatically when needed.";

"help.topic.view.title" = "Pages, Zoom & Navigation";
"help.topic.view.summary" = "Choose a reading layout and move through the document comfortably.";
"help.item.page_panel.title" = "Show and place the page panel";
"help.item.page_panel.detail" = "The panel icon shows or hides thumbnails. The four-direction icon places the panel on the left, right, top, or bottom.";
"help.item.page_layout.title" = "Choose how many pages to view";
"help.item.page_layout.detail" = "The portrait icon shows one page. The icon with a partial spread below gives continuous two-page scrolling; the icon with exactly two pages keeps only the current spread visible and moves two pages at a time. The four-page icon and direction menu control four-page groups, and the number icon accepts 1–12 pages.";
"help.item.zoom_pan.title" = "Zoom and pan";
"help.item.zoom_pan.detail" = "Pinch to zoom and use native two-finger scrolling. By default, hold Option and scroll to zoom; one- and two-page views keep the pointer anchored, while the multi-page overview uses its center. Hold Shift and scroll vertically to pan horizontally. The zoom modifier can be changed to Command or Off in Settings.";
"help.item.thumbnails.title" = "Adjust thumbnail groups";
"help.item.thumbnails.detail" = "The page panel can show single pages, fixed left-right pairs, or four-page groups. Use its slider, plus/minus buttons, or trackpad magnification, and drag a real page thumbnail to reorder.";

"help.topic.compare.title" = "Compare PDFs";
"help.topic.compare.summary" = "Read two to four open documents side by side or vertically.";
"help.item.compare_start.title" = "Start a comparison";
"help.item.compare_start.detail" = "Open at least two PDFs, then select the overlapping-rectangles icon and choose the documents.";
"help.item.compare_layout.title" = "Reorder and resize panels";
"help.item.compare_layout.detail" = "Choose a side-by-side or stacked layout. Drag a panel header to reorder it and drag the divider to adjust neighboring widths or heights.";
"help.item.compare_sync.title" = "Synchronize or lock scrolling";
"help.item.compare_sync.detail" = "Turn on scroll synchronization to follow relative document progress. Lock any panel that should stay in place.";

"help.topic.edit.title" = "Edit & Annotate";
"help.topic.edit.summary" = "Add standard PDF annotations and safely manage pages.";
"help.item.tools.title" = "Select, text, pen, and eraser";
"help.item.tools.detail" = "The segmented tool control switches between object selection, free-text insertion, ink drawing, and ink erasing. Detailed editing is available in one- and two-page views.";
"help.item.markup.title" = "Highlight, sign, and add images";
"help.item.markup.detail" = "Select PDF text before using the highlighter. The signature icon opens trackpad capture, and the photo-plus icon places an image on the current page.";
"help.item.pages.title" = "Assemble pages";
"help.item.pages.detail" = "The page menu merges PDFs, saves selected pages as one PDF or separate PDFs, rotates pages, or deletes them. Thumbnails can also be selected and dragged to reorder.";
"help.item.ocr.title" = "Run local OCR";
"help.item.ocr.detail" = "The OCR button uses Apple Vision on this Mac, can resume page checkpoints, and exports a searchable copy without sending the PDF to a server.";
"help.item.move_delete.title" = "Move or delete added objects";
"help.item.move_delete.detail" = "With the Select tool, drag added text, signatures, or images. Arrow keys move 1 point, Shift+Arrow moves 10 points, Delete removes, and Escape clears selection. Images also support resize, crop, and layer controls.";

"help.topic.signature.title" = "Signatures";
"help.topic.signature.summary" = "Capture, store, and place a clean handwritten signature.";
"help.item.signature_capture.title" = "Capture with a trackpad or mouse";
"help.item.signature_capture.detail" = "Press Start Trackpad Input, then draw with one finger using a light touch. Sensitivity, smoothing, width, velocity, color, and mouse input are available.";
"help.item.signature_secure.title" = "Manage the saved signature";
"help.item.signature_secure.detail" = "A successfully applied signature can be stored in the current macOS user's non-synchronizing Keychain. Replace or delete it from Saved Signature Management.";
"help.item.signature_place.title" = "Position the signature";
"help.item.signature_place.detail" = "After applying, the Select tool activates. Drag the clean signature into its field and use the corner handles to resize it.";

"help.topic.ai.title" = "PDF AI";
"help.topic.ai.summary" = "Use external AI only with an explicit provider, scope, and consent.";
"help.item.ai_setup.title" = "Connect a provider";
"help.item.ai_setup.detail" = "In Settings, choose OpenAI, Claude, Gemini, DeepSeek, Qwen, or a custom compatible endpoint, select a model, and save its API key in Keychain.";
"help.item.ai_actions.title" = "Choose an action and scope";
"help.item.ai_actions.detail" = "The sparkles button opens summary, analysis, problem solving, fill draft, related-PDF, and web research actions for selected text, pages, or representative document context.";
"help.item.ai_privacy.title" = "Review before sending";
"help.item.ai_privacy.detail" = "HwattakPDF shows the text and conversation that will leave the Mac before every request. The raw PDF is not uploaded automatically; web and MCP tools are opt-in, and MCP calls require approval.";

"help.topic.save.title" = "Save Safely";
"help.topic.save.summary" = "Know when the PDF file changes and when only the workspace is remembered.";
"help.item.save_choices.title" = "Save PDF changes";
"help.item.save_choices.detail" = "⌘S offers to overwrite the original, save a copy, or cancel. The Save button becomes highlighted when the active PDF has unsaved changes.";
"help.item.save_copy.title" = "Save a separate copy";
"help.item.save_copy.detail" = "⇧⌘S opens Save a Copy directly. The original is preserved and the saved copy becomes the current clean document.";
"help.item.save_close.title" = "Close without losing work";
"help.item.save_close.detail" = "Closing a dirty tab, window, or the app asks whether to overwrite, save a copy, discard, or cancel. Cancel leaves the document open.";
"help.item.session_vs_pdf.title" = "Session restore is not PDF save";
"help.item.session_vs_pdf.detail" = "Tab stacks, workspaces, windows, comparison layout, pages, and view positions are remembered automatically. Annotation and page edits reach the PDF file only after you save.";

