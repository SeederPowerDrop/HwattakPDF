"help.topic.accessibility.title" = "Accessibility & Comfort";
"help.topic.accessibility.summary" = "Discover controls without giving up native Mac behavior.";
"help.item.accessibility_labels.title" = "Tooltips and VoiceOver";
"help.item.accessibility_labels.detail" = "Hover over an icon for a tooltip. Major controls expose names, values, selected state, and hints to VoiceOver.";
"help.item.accessibility_keyboard.title" = "Keyboard-friendly controls";
"help.item.accessibility_keyboard.detail" = "Use Tab to move between controls, Return for the default sheet action, and Escape to cancel. Selected added objects also respond to arrows, Shift+Arrow, Delete, and Escape.";
"help.item.accessibility_display.title" = "Display and input preferences";
"help.item.accessibility_display.detail" = "The interface follows Light and Dark appearance and supports right-to-left layout. If a modifier conflicts with macOS Accessibility Zoom, change or disable scroll zoom in Settings.";

"help.item.page_jump.title" = "Jump directly to a page";
"help.item.page_jump.detail" = "Enter a number from 1 through the total page count in the toolbar or page panel, then press Return. An out-of-range value does not navigate; press Escape to cancel the edit.";
"help.item.sidebar_resize.title" = "Resize the page panel";
"help.item.sidebar_resize.detail" = "Drag the divider between the panel and PDF. Left and right placements remember their width, while top and bottom placements remember their height separately across position changes and app launches.";
