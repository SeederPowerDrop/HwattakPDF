"help.topic.plugins.title" = "Plugins";
"help.topic.plugins.summary" = "Add only the capabilities you need while safely managing permissions and resource use.";
"help.item.plugin_install.title" = "Installation and management";
"help.item.plugin_install.detail" = "Open Plugins > Manage Plugins… in the menu bar, then select a .hwattakplugin folder package with Install Plugin…. Review its name, author, version, and requested permissions before installation. Afterward, use the enabled switch to turn it on or off, or remove it.";
"help.item.plugin_permissions.title" = "Review least-privilege access";
"help.item.plugin_permissions.detail" = "V1 permissions are limited to document information, selected text, clipboard writes, and confirmed external links. V2 separately discloses current-page text, translation service, YouTube, or embedded web-panel access. Do not install a plugin that requests access unrelated to its purpose.";
"help.item.plugin_safety.title" = "Safety and trust boundary";
"help.item.plugin_safety.detail" = "V1 plugins use validated declarative templates and cannot access arbitrary code, shells, Keychain, raw PDF bytes, the network, or GPU directly. V2 web panels display app-reviewed external sites in temporary sessions, but remote JavaScript, cookies, tracking, and subresource requests can run. Address-bar and top-level navigation policy is not a tracker blocker or firewall.";
"help.item.plugin_performance.title" = "Performance and troubleshooting";
"help.item.plugin_performance.detail" = "Plugins are limited to 32 installations, 24 actions per plugin, and 2 MB per package. They run only when needed and create no normal CPU or GPU work. If the app slows down or errors recur, disable the plugin, refresh the list, then review the quarantined-package message or remove the plugin.";

