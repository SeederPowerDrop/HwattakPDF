"about.support" = "Apoyar HwattakPDF";
"about.introduction.1" = "Había comprado y utilizaba otro programa de PDF, pero con el tiempo incluso sus funciones más básicas pasaron a requerir una suscripción. Me frustró tanto que decidí crear HwattakPDF mediante vibe coding.";
"about.introduction.2" = "Entiendo que esa empresa también necesita ganarse la vida, pero la medida me pareció profundamente injusta para quienes ya habían pagado por el programa. Por eso decidí crear HwattakPDF.";
"about.introduction.3" = "Espero que HwattakPDF ayude a muchas personas a trabajar con sus PDF de manera más cómoda.";
"about.introduction.4" = "Haré todo lo posible por mantener HwattakPDF gratis de por vida y seguir ofreciéndole soporte. Solo aceptaré pequeñas propinas voluntarias.";
"about.introduction.5" = "Y ERW FWS WRG";
"about.support.title" = "El apoyo que mantiene gratuito a HwattakPDF";
"about.support.detail" = "HwattakPDF no tiene suscripciones ni anuncios. Las donaciones voluntarias son la única fuente de apoyo que me permite continuar desarrollándolo y manteniéndolo de forma gratuita.";
"about.image_accessibility" = "Ilustración de personaje en blanco y negro proporcionada por el creador";
