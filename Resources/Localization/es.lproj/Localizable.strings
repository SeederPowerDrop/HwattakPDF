"help.topic.accessibility.title" = "Accesibilidad y comodidad";
"help.topic.accessibility.summary" = "Descubre los controles sin renunciar al comportamiento nativo del Mac.";
"help.item.accessibility_labels.title" = "Descripciones emergentes y VoiceOver";
"help.item.accessibility_labels.detail" = "Coloca el puntero sobre un icono para ver su descripción. Los controles principales comunican a VoiceOver sus nombres, valores, estado de selección e indicaciones.";
"help.item.accessibility_keyboard.title" = "Controles accesibles con el teclado";
"help.item.accessibility_keyboard.detail" = "Usa Tab para moverte entre controles, Retorno para la acción predeterminada de una hoja y Escape para cancelar. Los objetos añadidos que estén seleccionados también responden a las flechas, Mayús+flecha, Suprimir y Escape.";
"help.item.accessibility_display.title" = "Preferencias de visualización y entrada";
"help.item.accessibility_display.detail" = "La interfaz sigue la apariencia clara u oscura y admite la disposición de derecha a izquierda. Si una tecla modificadora entra en conflicto con el zoom de accesibilidad de macOS, cambia o desactiva el zoom con desplazamiento en Ajustes.";
"help.item.page_jump.title" = "Ir directamente a una página";
"help.item.page_jump.detail" = "Introduce en la barra de herramientas o el panel de páginas un número entre 1 y el total de páginas y pulsa Retorno. Un valor fuera del intervalo no cambia de página; pulsa Escape para cancelar la edición.";
"help.item.sidebar_resize.title" = "Cambiar el tamaño del panel de páginas";
"help.item.sidebar_resize.detail" = "Arrastra el separador entre el panel y el PDF. Las posiciones izquierda y derecha recuerdan su anchura, mientras que las posiciones superior e inferior recuerdan su altura por separado aunque cambies la posición o reinicies la app.";
