"help.title" = "Guía de usuario de HwattakPDF";
"help.menu" = "Guía de usuario de HwattakPDF";
"help.subtitle" = "Aprende a usar los iconos, gestos, atajos y flujos de trabajo seguros con documentos.";
"help.search" = "Buscar funciones o atajos";
"help.no_results.title" = "Sin resultados";
"help.no_results.detail" = "Prueba con otro nombre de función o atajo de teclado.";
"help.hover_tip" = "Consejo: coloca el puntero sobre cualquier icono de la barra de herramientas para ver su nombre y función.";
