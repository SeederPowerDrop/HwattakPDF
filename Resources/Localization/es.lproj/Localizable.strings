"help.topic.start.title" = "Primeros pasos";
"help.topic.start.summary" = "Abre archivos PDF y familiarízate con el espacio de trabajo principal.";
"help.item.open.title" = "Abrir un PDF";
"help.item.open.detail" = "Usa el icono de carpeta o ⌘O. Si seleccionas varios PDF, cada uno se abre en su propia pestaña.";
"help.item.layout.title" = "Conocer la pantalla";
"help.item.layout.detail" = "La barra superior gestiona espacios de trabajo, pestañas, comparaciones y recursos. La barra de herramientas inferior controla páginas, vistas, edición, OCR, IA y búsqueda.";
"help.item.resume.title" = "Retomar el trabajo";
"help.item.resume.detail" = "Después de cerrar normalmente, se restauran los archivos, espacios de trabajo, orden y grupos de pestañas, páginas activas, estado de vista y disposición de comparación. Las ediciones del PDF todavía deben guardarse.";

"help.topic.tabs.title" = "Pestañas, grupos y espacios de trabajo";
"help.topic.tabs.summary" = "Organiza muchos documentos sin perder el estado individual de cada uno.";
"help.item.tab_stack.title" = "Crear y reordenar un grupo de pestañas";
"help.item.tab_stack.detail" = "Suelta una pestaña en el centro de otra para agruparlas. Suéltala cerca de un borde si solo quieres cambiar el orden.";
"help.item.unstack.title" = "Sacar una pestaña del grupo";
"help.item.unstack.detail" = "Arrastra una pestaña agrupada al final de la fila principal para dejarla independiente, o suéltala en el área del documento para trasladar la sesión exacta a una nueva ventana de HwattakPDF.";
"help.item.workspace.title" = "Separar espacios de trabajo";
"help.item.workspace.detail" = "Usa el menú de cuadrados apilados para crear, renombrar, cambiar o eliminar espacios de trabajo y mover juntas las pestañas relacionadas.";
"help.item.resources.title" = "Supervisar el uso de recursos";
"help.item.resources.detail" = "El icono del indicador muestra la CPU, la memoria y la carga estimada de cada pestaña. Los PDF inactivos sin cambios entran en reposo automáticamente cuando hace falta.";

"help.topic.view.title" = "Páginas, zoom y navegación";
"help.topic.view.summary" = "Elige una disposición de lectura y recorre cómodamente el documento.";
"help.item.page_panel.title" = "Mostrar y colocar el panel de páginas";
"help.item.page_panel.detail" = "El icono de panel muestra u oculta las miniaturas. El icono de cuatro direcciones coloca el panel a la izquierda, derecha, arriba o abajo.";
"help.item.page_layout.title" = "Elegir cuántas páginas ver";
"help.item.page_layout.detail" = "El icono vertical muestra una página. El icono con un pliego parcial debajo activa el desplazamiento continuo de dos páginas; el icono con exactamente dos páginas mantiene visible solo el pliego actual y avanza de dos páginas en dos páginas. El icono de cuatro páginas y el menú de dirección controlan grupos de cuatro, y el icono numérico admite de 1 a 12 páginas.";
"help.item.zoom_pan.title" = "Aplicar zoom y desplazar";
"help.item.zoom_pan.detail" = "Pellizca para aplicar zoom y usa el desplazamiento nativo con dos dedos. De forma predeterminada, mantén pulsada Opción y desplázate para ampliar: las vistas de una y dos páginas mantienen el puntero anclado, mientras que la vista general multipágina usa su centro. Mantén Mayúsculas y desplázate verticalmente para moverte en horizontal. En Ajustes puedes cambiar el modificador a Comando o desactivarlo.";
"help.item.thumbnails.title" = "Ajustar los grupos de miniaturas";
"help.item.thumbnails.detail" = "El panel de páginas puede mostrar páginas individuales, pares fijos izquierda-derecha o grupos de cuatro páginas. Usa el control deslizante, los botones más/menos o el gesto de ampliación del trackpad, y arrastra una miniatura real para reordenarla.";

"help.topic.compare.title" = "Comparar archivos PDF";
"help.topic.compare.summary" = "Lee entre dos y cuatro documentos abiertos en paralelo o en vertical.";
"help.item.compare_start.title" = "Iniciar una comparación";
"help.item.compare_start.detail" = "Abre al menos dos PDF, selecciona el icono de rectángulos superpuestos y elige los documentos que quieras comparar.";
"help.item.compare_layout.title" = "Reordenar y cambiar el tamaño de los paneles";
"help.item.compare_layout.detail" = "Elige una disposición en paralelo o apilada. Arrastra el encabezado de un panel para cambiar su orden y el separador para ajustar el ancho o la altura de los paneles adyacentes.";
"help.item.compare_sync.title" = "Sincronizar o bloquear el desplazamiento";
"help.item.compare_sync.detail" = "Activa la sincronización del desplazamiento para seguir la posición relativa en los documentos. Bloquea cualquier panel que deba permanecer fijo.";

"help.topic.edit.title" = "Editar y anotar";
"help.topic.edit.summary" = "Añade anotaciones PDF estándar y gestiona las páginas de forma segura.";
"help.item.tools.title" = "Selección, texto, lápiz y borrador";
"help.item.tools.detail" = "El selector segmentado cambia entre la selección de objetos, la inserción de texto libre, el dibujo con tinta y su borrado. La edición detallada está disponible en las vistas de una y dos páginas.";
"help.item.markup.title" = "Resaltar, firmar y añadir imágenes";
"help.item.markup.detail" = "Selecciona texto del PDF antes de usar el resaltador. El icono de firma abre la captura con trackpad y el icono de foto con un signo más coloca una imagen en la página actual.";
"help.item.pages.title" = "Organizar páginas";
"help.item.pages.detail" = "El menú de páginas combina archivos PDF, guarda las páginas seleccionadas en un solo PDF o en PDF separados, las gira o las elimina. También puedes seleccionar y arrastrar miniaturas para cambiar su orden.";
"help.item.ocr.title" = "Ejecutar OCR local";
"help.item.ocr.detail" = "El botón OCR utiliza Apple Vision en este Mac, puede reanudar los puntos de control de cada página y exporta una copia con búsqueda sin enviar el PDF a ningún servidor.";
"help.item.move_delete.title" = "Mover o eliminar objetos añadidos";
"help.item.move_delete.detail" = "Con la herramienta Selección puedes arrastrar texto, firmas o imágenes añadidos. Las flechas mueven 1 punto, Mayús+flecha mueve 10 puntos, Suprimir elimina y Escape anula la selección. Las imágenes también permiten cambiar el tamaño, recortar y controlar las capas.";

"help.topic.signature.title" = "Firmas";
"help.topic.signature.summary" = "Captura, guarda y coloca una firma manuscrita limpia.";
"help.item.signature_capture.title" = "Capturar con trackpad o ratón";
"help.item.signature_capture.detail" = "Pulsa Iniciar entrada con trackpad y dibuja con un dedo aplicando un toque ligero. Puedes ajustar la sensibilidad, suavizado, ancho, velocidad y color, y permitir la entrada con ratón.";
"help.item.signature_secure.title" = "Gestionar la firma guardada";
"help.item.signature_secure.detail" = "Una firma aplicada correctamente puede guardarse en el Llavero no sincronizado del usuario actual de macOS. Sustitúyela o elimínala desde Gestión de firmas guardadas.";
"help.item.signature_place.title" = "Colocar la firma";
"help.item.signature_place.detail" = "Tras aplicarla, se activa la herramienta Selección. Arrastra la firma limpia hasta su campo y usa los tiradores de las esquinas para cambiar su tamaño.";

"help.topic.ai.title" = "IA para PDF";
"help.topic.ai.summary" = "Usa una IA externa solo tras elegir de forma explícita el proveedor, el alcance y dar tu consentimiento.";
"help.item.ai_setup.title" = "Conectar un proveedor";
"help.item.ai_setup.detail" = "En Ajustes, elige OpenAI, Claude, Gemini, DeepSeek, Qwen o un endpoint compatible personalizado, selecciona un modelo y guarda su clave API en el Llavero.";
"help.item.ai_actions.title" = "Elegir una acción y un alcance";
"help.item.ai_actions.detail" = "El botón de destellos ofrece acciones de resumen, análisis, resolución de problemas, borrador para rellenar, búsqueda de PDF relacionados e investigación web para el texto seleccionado, páginas o un contexto representativo del documento.";
"help.item.ai_privacy.title" = "Revisar antes de enviar";
"help.item.ai_privacy.detail" = "Antes de cada solicitud, HwattakPDF muestra el texto y la conversación que saldrán del Mac. El PDF original no se sube automáticamente; las herramientas web y MCP son opcionales, y las llamadas MCP requieren aprobación.";

"help.topic.save.title" = "Guardar de forma segura";
"help.topic.save.summary" = "Distingue cuándo cambia el archivo PDF y cuándo solo se recuerda el espacio de trabajo.";
"help.item.save_choices.title" = "Guardar los cambios del PDF";
"help.item.save_choices.detail" = "⌘S permite sobrescribir el original, guardar una copia o cancelar. El botón Guardar se resalta cuando el PDF activo tiene cambios sin guardar.";
"help.item.save_copy.title" = "Guardar una copia independiente";
"help.item.save_copy.detail" = "⇧⌘S abre directamente Guardar una copia. El original se conserva y la copia guardada pasa a ser el documento actual sin cambios pendientes.";
"help.item.save_close.title" = "Cerrar sin perder el trabajo";
"help.item.save_close.detail" = "Al cerrar una pestaña modificada, una ventana o la app, puedes sobrescribir, guardar una copia, descartar o cancelar. Si cancelas, el documento permanece abierto.";
"help.item.session_vs_pdf.title" = "Restaurar la sesión no guarda el PDF";
"help.item.session_vs_pdf.detail" = "Los grupos de pestañas, espacios de trabajo, ventanas, disposición de comparación, páginas y posiciones de vista se recuerdan automáticamente. Las ediciones de anotaciones y páginas solo llegan al archivo PDF después de guardarlo.";

