"help.key.shift" = "Maj";
"help.key.option" = "Option";
"help.key.control" = "Contrôle";

"help.topic.start.title" = "Bien démarrer";
"help.topic.start.summary" = "Ouvrez des PDF et découvrez l’espace de travail principal.";
"help.item.open.title" = "Ouvrir un PDF";
"help.item.open.detail" = "Utilisez l’icône de dossier ou ⌘O. Si vous sélectionnez plusieurs PDF, chacun s’ouvre dans son propre onglet.";
"help.item.layout.title" = "Comprendre l’écran";
"help.item.layout.detail" = "La barre supérieure gère les espaces de travail, les onglets, la comparaison et les ressources. La barre d’outils située dessous contrôle les pages, les modes d’affichage, l’édition, l’OCR, l’IA et la recherche.";
"help.item.resume.title" = "Reprendre votre travail";
"help.item.resume.detail" = "Après une fermeture normale, les fichiers, espaces de travail, ordre et piles d’onglets, pages actives, réglages d’affichage et disposition de comparaison sont restaurés. Les modifications du PDF doivent néanmoins être enregistrées.";

"help.topic.tabs.title" = "Onglets, piles et espaces de travail";
"help.topic.tabs.summary" = "Organisez de nombreux documents sans perdre leur état individuel.";
"help.item.tab_stack.title" = "Créer et réorganiser une pile d’onglets";
"help.item.tab_stack.detail" = "Déposez un onglet au centre d’un autre pour les empiler. Déposez-le près d’un bord pour simplement modifier leur ordre.";
"help.item.unstack.title" = "Retirer un onglet d’une pile";
"help.item.unstack.detail" = "Faites glisser un onglet empilé à la fin de la rangée principale pour le rendre autonome, ou déposez-le dans la zone du document pour transférer la session telle quelle vers une nouvelle fenêtre HwattakPDF.";
"help.item.workspace.title" = "Séparer les espaces de travail";
"help.item.workspace.detail" = "Utilisez le menu aux carrés empilés pour créer, renommer, changer ou supprimer des espaces de travail, et déplacer ensemble les onglets associés.";
"help.item.resources.title" = "Surveiller l’utilisation des ressources";
"help.item.resources.detail" = "L’icône de jauge affiche le processeur, la mémoire et une estimation de la charge de chaque onglet. Les PDF inactifs sans modification sont automatiquement mis en veille si nécessaire.";

"help.topic.view.title" = "Pages, zoom et navigation";
"help.topic.view.summary" = "Choisissez une disposition de lecture et parcourez confortablement le document.";
"help.item.page_panel.title" = "Afficher et placer le panneau des pages";
"help.item.page_panel.detail" = "L’icône de panneau affiche ou masque les vignettes. L’icône à quatre directions place le panneau à gauche, à droite, en haut ou en bas.";
"help.item.page_layout.title" = "Choisir le nombre de pages affichées";
"help.item.page_layout.detail" = "L’icône portrait affiche une page. L’icône avec une double page partielle en dessous active le défilement continu sur deux pages ; l’icône avec exactement deux pages garde uniquement la double page actuelle et avance de deux pages à la fois. L’icône à quatre pages et le menu de direction contrôlent les groupes de quatre pages, tandis que l’icône numérique accepte de 1 à 12 pages.";
"help.item.zoom_pan.title" = "Zoomer et déplacer la vue";
"help.item.zoom_pan.detail" = "Pincez pour zoomer et utilisez le défilement natif à deux doigts. Par défaut, maintenez Option et faites défiler pour zoomer : les vues à une ou deux pages restent ancrées sous le pointeur, tandis que l’aperçu multipage utilise son centre. Maintenez Maj et faites défiler verticalement pour vous déplacer horizontalement. Dans Réglages, le modificateur de zoom peut être remplacé par Commande ou désactivé.";
"help.item.thumbnails.title" = "Régler les groupes de vignettes";
"help.item.thumbnails.detail" = "Le panneau des pages peut afficher des pages seules, des paires gauche-droite fixes ou des groupes de quatre pages. Utilisez son curseur, les boutons plus et moins ou le geste de zoom du trackpad, puis faites glisser une vraie vignette de page pour la réorganiser.";

"help.topic.compare.title" = "Comparer des PDF";
"help.topic.compare.summary" = "Lisez deux à quatre documents ouverts côte à côte ou verticalement.";
"help.item.compare_start.title" = "Démarrer une comparaison";
"help.item.compare_start.detail" = "Ouvrez au moins deux PDF, puis sélectionnez l’icône aux rectangles superposés et choisissez les documents à comparer.";
"help.item.compare_layout.title" = "Réorganiser et redimensionner les panneaux";
"help.item.compare_layout.detail" = "Choisissez une disposition côte à côte ou empilée. Faites glisser l’en-tête d’un panneau pour le réorganiser et le séparateur pour ajuster la largeur ou la hauteur des panneaux voisins.";
"help.item.compare_sync.title" = "Synchroniser ou verrouiller le défilement";
"help.item.compare_sync.detail" = "Activez la synchronisation du défilement pour suivre la progression relative dans les documents. Verrouillez tout panneau qui doit rester en place.";

"help.topic.edit.title" = "Modifier et annoter";
"help.topic.edit.summary" = "Ajoutez des annotations PDF standard et gérez les pages en toute sécurité.";
"help.item.tools.title" = "Sélection, texte, stylo et gomme";
"help.item.tools.detail" = "Le sélecteur d’outils permet de choisir la sélection d’objets, l’insertion de texte libre, le dessin à l’encre ou son effacement. L’édition détaillée est disponible dans les vues à une ou deux pages.";
"help.item.markup.title" = "Surligner, signer et ajouter des images";
"help.item.markup.detail" = "Sélectionnez du texte dans le PDF avant d’utiliser le surligneur. L’icône de signature ouvre la saisie au trackpad et l’icône photo avec un plus place une image sur la page actuelle.";
"help.item.pages.title" = "Assembler les pages";
"help.item.pages.detail" = "Le menu des pages permet de fusionner des PDF, d’enregistrer les pages sélectionnées dans un seul PDF ou dans des PDF séparés, de les faire pivoter ou de les supprimer. Vous pouvez aussi sélectionner et faire glisser les vignettes pour les réorganiser.";
"help.item.ocr.title" = "Lancer l’OCR local";
"help.item.ocr.detail" = "Le bouton OCR utilise Apple Vision sur ce Mac, peut reprendre à partir des points de contrôle de page et exporte une copie interrogeable sans envoyer le PDF à un serveur.";
"help.item.move_delete.title" = "Déplacer ou supprimer les objets ajoutés";
"help.item.move_delete.detail" = "Avec l’outil Sélection, faites glisser le texte, les signatures ou les images ajoutés. Les flèches déplacent d’un point, Maj+flèche de 10 points, Suppr efface l’objet et Échap annule la sélection. Les images peuvent aussi être redimensionnées, recadrées et réorganisées par calques.";

"help.topic.signature.title" = "Gestion des signatures";
"help.topic.signature.summary" = "Capturez, conservez et placez une signature manuscrite propre.";
"help.item.signature_capture.title" = "Capturer avec un trackpad ou une souris";
"help.item.signature_capture.detail" = "Appuyez sur Démarrer la saisie au trackpad, puis dessinez d’un doigt avec une légère pression. Vous pouvez régler la sensibilité, le lissage, l’épaisseur, la vitesse et la couleur, ou autoriser la souris.";
"help.item.signature_secure.title" = "Gérer la signature enregistrée";
"help.item.signature_secure.detail" = "Une signature correctement appliquée peut être conservée dans le Trousseau non synchronisé de l’utilisateur macOS actuel. Remplacez-la ou supprimez-la dans Gestion de la signature enregistrée.";
"help.item.signature_place.title" = "Positionner la signature";
"help.item.signature_place.detail" = "Après l’application, l’outil Sélection s’active. Faites glisser la signature propre dans son champ et utilisez les poignées d’angle pour la redimensionner.";

"help.topic.ai.title" = "IA PDF";
"help.topic.ai.summary" = "Utilisez une IA externe uniquement après avoir choisi explicitement le fournisseur, la portée et donné votre consentement.";
"help.item.ai_setup.title" = "Connecter un fournisseur";
"help.item.ai_setup.detail" = "Dans Réglages, choisissez OpenAI, Claude, Gemini, DeepSeek, Qwen ou un endpoint compatible personnalisé, sélectionnez un modèle et enregistrez sa clé API dans le Trousseau.";
"help.item.ai_actions.title" = "Choisir une action et une portée";
"help.item.ai_actions.detail" = "Le bouton à étincelles propose le résumé, l’analyse, la résolution de problèmes, un brouillon à remplir, la recherche de PDF associés et la recherche web à partir du texte sélectionné, de pages ou d’un contexte représentatif du document.";
"help.item.ai_privacy.title" = "Vérifier avant l’envoi";
"help.item.ai_privacy.detail" = "Avant chaque requête, HwattakPDF affiche le texte et la conversation qui quitteront le Mac. Le PDF brut n’est jamais téléversé automatiquement ; les outils web et MCP sont facultatifs, et chaque appel MCP doit être approuvé.";

"help.topic.save.title" = "Enregistrer en toute sécurité";
"help.topic.save.summary" = "Distinguez les changements apportés au fichier PDF des seuls réglages mémorisés dans l’espace de travail.";
"help.item.save_choices.title" = "Enregistrer les modifications du PDF";
"help.item.save_choices.detail" = "⌘S propose d’écraser l’original, d’enregistrer une copie ou d’annuler. Le bouton Enregistrer est mis en évidence lorsque le PDF actif contient des modifications non enregistrées.";
"help.item.save_copy.title" = "Enregistrer une copie séparée";
"help.item.save_copy.detail" = "⇧⌘S ouvre directement Enregistrer une copie. L’original est préservé et la copie enregistrée devient le document actuel sans modification en attente.";
"help.item.save_close.title" = "Fermer sans perdre votre travail";
"help.item.save_close.detail" = "À la fermeture d’un onglet modifié, d’une fenêtre ou de l’app, vous pouvez écraser l’original, enregistrer une copie, ignorer les modifications ou annuler. Annuler laisse le document ouvert.";
"help.item.session_vs_pdf.title" = "La restauration de session n’enregistre pas le PDF";
"help.item.session_vs_pdf.detail" = "Les piles d’onglets, espaces de travail, fenêtres, dispositions de comparaison, pages et positions d’affichage sont mémorisés automatiquement. Les annotations et modifications de pages ne sont écrites dans le fichier PDF qu’après son enregistrement.";

