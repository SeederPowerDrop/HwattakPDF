/* Help tutorial */
"help.title" = "Guide d’utilisation de HwattakPDF";
"help.menu" = "Guide d’utilisation de HwattakPDF";
"help.subtitle" = "Découvrez les icônes, les gestes, les raccourcis et les méthodes sûres pour travailler sur vos documents.";
"help.search" = "Rechercher une fonction ou un raccourci";
"help.no_results.title" = "Aucun résultat";
"help.no_results.detail" = "Essayez un autre nom de fonction ou raccourci clavier.";
"help.hover_tip" = "Astuce : survolez une icône de la barre d’outils pour connaître son nom et son rôle.";
