"menu.redo_named" = "Rétablir %@";
"status.undo_completed" = "%@ annulé";
"status.redo_completed" = "%@ rétabli";
"help.item.undo_redo.title" = "Annuler et rétablir les modifications du PDF";
"help.item.undo_redo.detail" = "Utilisez ⌘Z pour annuler et ⇧⌘Z pour rétablir. HwattakPDF conserve jusqu’à 22 actions réversibles par PDF, notamment le stylo, les annotations, les objets ajoutés et les opérations sur les pages, sans garder 22 copies complètes du PDF.";
"help.shortcut.undo" = "Annuler la dernière modification du PDF";
