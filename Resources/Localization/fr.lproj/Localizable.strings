"help.topic.accessibility.title" = "Accessibilité et confort";
"help.topic.accessibility.summary" = "Découvrez les commandes tout en conservant le comportement natif du Mac.";
"help.item.accessibility_labels.title" = "Infobulles et VoiceOver";
"help.item.accessibility_labels.detail" = "Survolez une icône pour afficher son infobulle. Les commandes principales communiquent leur nom, leur valeur, leur état de sélection et leurs indications à VoiceOver.";
"help.item.accessibility_keyboard.title" = "Commandes adaptées au clavier";
"help.item.accessibility_keyboard.detail" = "Utilisez Tab pour passer d’une commande à l’autre, Retour pour l’action par défaut d’une feuille et Échap pour annuler. Les objets ajoutés et sélectionnés répondent aussi aux flèches, à Maj+flèche, à Suppr et à Échap.";
"help.item.accessibility_display.title" = "Préférences d’affichage et de saisie";
"help.item.accessibility_display.detail" = "L’interface suit les apparences claire et sombre et prend en charge la disposition de droite à gauche. Si une touche modificatrice entre en conflit avec le zoom d’accessibilité de macOS, modifiez ou désactivez le zoom par défilement dans Réglages.";
"help.item.page_jump.title" = "Accéder directement à une page";
"help.item.page_jump.detail" = "Saisissez dans la barre d’outils ou le panneau des pages un numéro compris entre 1 et le nombre total de pages, puis appuyez sur Retour. Une valeur hors limites ne change pas de page ; appuyez sur Échap pour annuler la saisie.";
"help.item.sidebar_resize.title" = "Redimensionner le panneau des pages";
"help.item.sidebar_resize.detail" = "Faites glisser le séparateur entre le panneau et le PDF. Les positions gauche et droite mémorisent leur largeur, tandis que les positions haute et basse mémorisent séparément leur hauteur, même après un changement de position ou un nouveau lancement de l’app.";
