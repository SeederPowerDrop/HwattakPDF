"help.item.resources.title" = "리소스 사용량 확인";
"help.item.resources.detail" = "게이지 아이콘에서 CPU·메모리와 탭별 예상 부담을 확인합니다. 변경 없는 비활성 PDF는 필요할 때 자동으로 휴면합니다.";

"help.topic.view.title" = "페이지·확대·이동";
"help.topic.view.summary" = "읽기 방식에 맞게 배치를 고르고 문서를 편안하게 이동합니다.";
"help.item.page_panel.title" = "페이지 패널 표시와 위치";
"help.item.page_panel.detail" = "패널 아이콘으로 썸네일을 보이거나 숨깁니다. 네 방향 아이콘으로 왼쪽·오른쪽·위·아래 위치를 고릅니다.";
"help.item.page_layout.title" = "한 번에 볼 페이지 수";
"help.item.page_layout.detail" = "세로 사각형은 1페이지입니다. 아래 펼침이 살짝 보이는 아이콘은 연속 2페이지, 두 장만 있는 아이콘은 현재 펼침만 보이는 고정 2페이지입니다. 고정 보기에서는 두 페이지 단위로 이동합니다. 4페이지 아이콘과 방향 메뉴는 4장 묶음을 조절하며, 숫자 아이콘에는 1~12를 입력할 수 있습니다.";
"help.item.zoom_pan.title" = "확대·축소와 좌우 이동";
"help.item.zoom_pan.detail" = "핀치 확대와 두 손가락 기본 스크롤을 그대로 사용합니다. 기본 설정에서는 Option을 누르고 스크롤해 확대합니다. 1·2페이지 본문은 포인터 위치를 유지하고 다중 페이지 개요는 화면 가운데를 기준으로 합니다. Shift를 누르고 세로 스크롤하면 좌우로 이동하며, 설정에서 확대 키를 Command 또는 끄기로 바꿀 수 있습니다.";
"help.item.thumbnails.title" = "썸네일 묶음과 크기";
"help.item.thumbnails.detail" = "페이지 패널을 1장, 고정된 좌우 2장, 4장 묶음으로 표시할 수 있습니다. 슬라이더·+/−·트랙패드 확대를 사용하고 실제 페이지 썸네일을 끌어 순서를 바꿉니다.";

"help.topic.compare.title" = "PDF 비교";
"help.topic.compare.summary" = "열린 문서 2~4개를 좌우 또는 위아래로 함께 읽습니다.";
"help.item.compare_start.title" = "비교 시작";
"help.item.compare_start.detail" = "PDF를 두 개 이상 연 다음 겹친 사각형 아이콘을 누르고 비교할 문서를 선택합니다.";
"help.item.compare_layout.title" = "패널 순서와 크기 조절";
"help.item.compare_layout.detail" = "좌우 또는 위아래 배치를 고릅니다. 패널 제목을 끌어 순서를 바꾸고 구분선을 끌어 이웃 패널의 너비나 높이를 조절합니다.";
"help.item.compare_sync.title" = "스크롤 동기화와 잠금";
"help.item.compare_sync.detail" = "스크롤 동기화를 켜면 문서 길이에 맞춘 진행 위치를 함께 이동합니다. 움직이면 안 되는 패널은 자물쇠로 잠그세요.";

"help.topic.edit.title" = "편집과 주석";
"help.topic.edit.summary" = "표준 PDF 주석을 추가하고 페이지를 안전하게 관리합니다.";
