"help.topic.accessibility.title" = "Acessibilidade e conforto";
"help.topic.accessibility.summary" = "Conheça os controlos sem abdicar do comportamento nativo do Mac.";
"help.item.accessibility_labels.title" = "Dicas e VoiceOver";
"help.item.accessibility_labels.detail" = "Passe o cursor sobre um ícone para ver uma dica. Os controlos principais comunicam ao VoiceOver os nomes, valores, estado de seleção e sugestões.";
"help.item.accessibility_keyboard.title" = "Controlos acessíveis pelo teclado";
"help.item.accessibility_keyboard.detail" = "Use Tab para percorrer os controlos, Return para a ação predefinida da caixa de diálogo e Escape para cancelar. Os objetos adicionados que estejam selecionados também respondem às setas, Maiúsculas+seta, Delete e Escape.";
"help.item.accessibility_display.title" = "Preferências de visualização e introdução";
"help.item.accessibility_display.detail" = "A interface acompanha o modo claro ou escuro e suporta disposição da direita para a esquerda. Se uma tecla modificadora entrar em conflito com o Zoom de acessibilidade do macOS, altere ou desative o zoom por deslocamento nas Definições.";
"help.item.page_jump.title" = "Ir diretamente para uma página";
"help.item.page_jump.detail" = "Introduza na barra de ferramentas ou no painel de páginas um número entre 1 e o total de páginas e prima Return. Um valor fora do intervalo não muda de página; prima Escape para cancelar a edição.";
"help.item.sidebar_resize.title" = "Redimensionar o painel de páginas";
"help.item.sidebar_resize.detail" = "Arraste o divisor entre o painel e o PDF. As posições à esquerda e à direita memorizam a largura, enquanto as posições em cima e em baixo memorizam a altura separadamente, mesmo depois de mudar a posição ou reiniciar a aplicação.";
