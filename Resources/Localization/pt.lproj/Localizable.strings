"help.title" = "Manual do HwattakPDF";
"help.menu" = "Manual do HwattakPDF";
"help.subtitle" = "Conheça os ícones, gestos, atalhos e fluxos de trabalho seguros para documentos.";
"help.search" = "Pesquisar funcionalidades ou atalhos";
"help.no_results.title" = "Sem resultados";
"help.no_results.detail" = "Experimente outro nome de funcionalidade ou atalho de teclado.";
"help.hover_tip" = "Dica: passe o cursor sobre qualquer ícone da barra de ferramentas para ver o respetivo nome e função.";
