"help.topic.start.title" = "Primeiros passos";
"help.topic.start.summary" = "Abra PDFs e conheça o espaço de trabalho principal.";
"help.item.open.title" = "Abrir um PDF";
"help.item.open.detail" = "Use o ícone de pasta ou ⌘O. Se selecionar vários PDFs, cada um abre no respetivo separador.";
"help.item.layout.title" = "Conhecer o ecrã";
"help.item.layout.detail" = "A barra superior gere espaços de trabalho, separadores, comparações e recursos. A barra de ferramentas abaixo controla páginas, vistas, edição, OCR, IA e pesquisa.";
"help.item.resume.title" = "Retomar o trabalho";
"help.item.resume.detail" = "Depois de sair normalmente, são restaurados os ficheiros, espaços de trabalho, ordem e pilhas de separadores, páginas ativas, estado de visualização e disposição de comparação. As edições do PDF continuam a ter de ser guardadas.";

"help.topic.tabs.title" = "Separadores, pilhas e espaços de trabalho";
"help.topic.tabs.summary" = "Organize muitos documentos sem perder o estado individual de cada um.";
"help.item.tab_stack.title" = "Criar e reorganizar uma pilha de separadores";
"help.item.tab_stack.detail" = "Largue um separador no centro de outro para os empilhar. Largue-o junto a uma extremidade se pretender apenas mudar a ordem.";
"help.item.unstack.title" = "Retirar um separador da pilha";
"help.item.unstack.detail" = "Arraste um separador empilhado para o fim da linha principal para o tornar independente, ou largue-o na área do documento para mover a sessão exata para uma nova janela do HwattakPDF.";
"help.item.workspace.title" = "Separar espaços de trabalho";
"help.item.workspace.detail" = "Use o menu de quadrados empilhados para criar, mudar o nome, alternar ou eliminar espaços de trabalho e mover em conjunto os separadores relacionados.";
"help.item.resources.title" = "Acompanhar a utilização de recursos";
"help.item.resources.detail" = "O ícone do medidor mostra a CPU, a memória e a carga estimada de cada separador. Os PDFs inativos sem alterações entram automaticamente em suspensão quando necessário.";

"help.topic.view.title" = "Páginas, zoom e navegação";
"help.topic.view.summary" = "Escolha uma disposição de leitura e percorra o documento confortavelmente.";
"help.item.page_panel.title" = "Mostrar e posicionar o painel de páginas";
"help.item.page_panel.detail" = "O ícone do painel mostra ou oculta miniaturas. O ícone de quatro direções coloca o painel à esquerda, à direita, em cima ou em baixo.";
"help.item.page_layout.title" = "Escolher quantas páginas apresentar";
"help.item.page_layout.detail" = "O ícone de página vertical mostra uma página. O ícone com parte do par seguinte por baixo ativa a deslocação contínua de duas páginas; o ícone com exatamente duas páginas mantém apenas o par atual visível e avança duas páginas de cada vez. O ícone de quatro páginas e o menu de direção controlam grupos de quatro, enquanto o ícone numérico aceita entre 1 e 12 páginas.";
"help.item.zoom_pan.title" = "Ampliar e deslocar";
"help.item.zoom_pan.detail" = "Faça o gesto de pinça para ampliar e use o deslocamento nativo com dois dedos. Por predefinição, mantenha Opção premida e desloque para ampliar: as vistas de uma e duas páginas mantêm o cursor ancorado, enquanto a visão geral de várias páginas usa o centro. Mantenha Maiúsculas premida e desloque verticalmente para mover na horizontal. Nas Definições, pode mudar o modificador para Comando ou desativá-lo.";
"help.item.thumbnails.title" = "Ajustar grupos de miniaturas";
"help.item.thumbnails.detail" = "O painel de páginas pode mostrar páginas individuais, pares fixos esquerda-direita ou grupos de quatro páginas. Use o controlo deslizante, os botões mais/menos ou o gesto de ampliação do trackpad e arraste uma miniatura de página real para mudar a ordem.";

"help.topic.compare.title" = "Comparar PDFs";
"help.topic.compare.summary" = "Leia entre dois e quatro documentos abertos lado a lado ou na vertical.";
"help.item.compare_start.title" = "Iniciar uma comparação";
"help.item.compare_start.detail" = "Abra pelo menos dois PDFs, selecione o ícone de retângulos sobrepostos e escolha os documentos que pretende comparar.";
"help.item.compare_layout.title" = "Reordenar e redimensionar painéis";
"help.item.compare_layout.detail" = "Escolha uma disposição lado a lado ou empilhada. Arraste o cabeçalho de um painel para mudar a ordem e o divisor para ajustar a largura ou a altura dos painéis adjacentes.";
"help.item.compare_sync.title" = "Sincronizar ou bloquear o deslocamento";
"help.item.compare_sync.detail" = "Ative a sincronização do deslocamento para acompanhar a posição relativa nos documentos. Bloqueie qualquer painel que deva permanecer no lugar.";

"help.topic.edit.title" = "Editar e anotar";
"help.topic.edit.summary" = "Adicione anotações PDF padrão e faça a gestão segura das páginas.";
"help.item.tools.title" = "Seleção, texto, caneta e borracha";
"help.item.tools.detail" = "O seletor segmentado alterna entre seleção de objetos, inserção de texto livre, desenho a tinta e apagamento de tinta. A edição detalhada está disponível nas vistas de uma e duas páginas.";
"help.item.markup.title" = "Realçar, assinar e adicionar imagens";
"help.item.markup.detail" = "Selecione texto no PDF antes de usar o marcador. O ícone de assinatura abre a captura pelo trackpad e o ícone de fotografia com um sinal de mais coloca uma imagem na página atual.";
"help.item.pages.title" = "Organizar páginas";
"help.item.pages.detail" = "O menu de páginas une PDFs, guarda as páginas selecionadas num único PDF ou em PDFs separados, roda-as ou elimina-as. Também pode selecionar e arrastar miniaturas para mudar a ordem.";
"help.item.ocr.title" = "Executar OCR local";
"help.item.ocr.detail" = "O botão OCR usa o Apple Vision neste Mac, pode retomar os pontos de controlo de página e exporta uma cópia pesquisável sem enviar o PDF para um servidor.";
"help.item.move_delete.title" = "Mover ou eliminar objetos adicionados";
"help.item.move_delete.detail" = "Com a ferramenta Seleção, arraste texto, assinaturas ou imagens adicionados. As setas movem 1 ponto, Maiúsculas+seta move 10 pontos, Delete elimina e Escape limpa a seleção. As imagens também permitem redimensionar, recortar e controlar as camadas.";

"help.topic.signature.title" = "Assinaturas";
"help.topic.signature.summary" = "Capture, guarde e posicione uma assinatura manuscrita limpa.";
"help.item.signature_capture.title" = "Capturar com o trackpad ou o rato";
"help.item.signature_capture.detail" = "Prima “Iniciar entrada pelo trackpad” e desenhe com um dedo, usando um toque leve. Pode ajustar a sensibilidade, suavização, largura, velocidade e cor, ou permitir a introdução com o rato.";
"help.item.signature_secure.title" = "Gerir a assinatura guardada";
"help.item.signature_secure.detail" = "Uma assinatura aplicada com êxito pode ser guardada no Porta-chaves não sincronizado do utilizador atual do macOS. Substitua-a ou elimine-a em “Gerir assinatura guardada”.";
"help.item.signature_place.title" = "Posicionar a assinatura";
"help.item.signature_place.detail" = "Depois de aplicar, a ferramenta Seleção fica ativa. Arraste a assinatura limpa para o respetivo campo e use as pegas dos cantos para a redimensionar.";

"help.topic.ai.title" = "IA para PDF";
"help.topic.ai.summary" = "Use IA externa apenas depois de escolher explicitamente o fornecedor, o âmbito e dar o seu consentimento.";
"help.item.ai_setup.title" = "Ligar um fornecedor";
"help.item.ai_setup.detail" = "Nas Definições, escolha OpenAI, Claude, Gemini, DeepSeek, Qwen ou um endpoint compatível personalizado, selecione um modelo e guarde a respetiva chave API no Porta-chaves.";
"help.item.ai_actions.title" = "Escolher uma ação e um âmbito";
"help.item.ai_actions.detail" = "O botão de brilhos disponibiliza resumo, análise, resolução de problemas, rascunho de preenchimento, pesquisa de PDFs relacionados e pesquisa na Web para texto selecionado, páginas ou um contexto representativo do documento.";
"help.item.ai_privacy.title" = "Rever antes de enviar";
"help.item.ai_privacy.detail" = "Antes de cada pedido, o HwattakPDF mostra o texto e a conversa que sairão do Mac. O PDF original não é carregado automaticamente; as ferramentas web e MCP são opcionais e as chamadas MCP exigem aprovação.";

"help.topic.save.title" = "Guardar em segurança";
"help.topic.save.summary" = "Saiba quando o ficheiro PDF é alterado e quando apenas o espaço de trabalho é memorizado.";
"help.item.save_choices.title" = "Guardar alterações do PDF";
"help.item.save_choices.detail" = "⌘S permite substituir o original, guardar uma cópia ou cancelar. O botão Guardar fica realçado quando o PDF ativo tem alterações por guardar.";
"help.item.save_copy.title" = "Guardar uma cópia separada";
"help.item.save_copy.detail" = "⇧⌘S abre diretamente Guardar uma cópia. O original é preservado e a cópia guardada torna-se o documento atual sem alterações pendentes.";
"help.item.save_close.title" = "Fechar sem perder o trabalho";
"help.item.save_close.detail" = "Ao fechar um separador com alterações, uma janela ou a aplicação, é-lhe perguntado se pretende substituir o original, guardar uma cópia, não guardar ou cancelar. Cancelar mantém o documento aberto.";
"help.item.session_vs_pdf.title" = "Restaurar a sessão não guarda o PDF";
"help.item.session_vs_pdf.detail" = "As pilhas de separadores, espaços de trabalho, janelas, disposição de comparação, páginas e posições de visualização são memorizadas automaticamente. As edições de anotações e páginas só chegam ao ficheiro PDF depois de guardar.";

"help.topic.shortcuts.title" = "Atalhos de teclado";
"help.topic.shortcuts.summary" = "Comandos comuns atualmente disponíveis no HwattakPDF.";
