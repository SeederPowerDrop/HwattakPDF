"about.github" = "GitHub · github.com/SeederPowerDrop/HwattakPDF";
"about.support" = "Ủng hộ HwattakPDF";
"about.introduction.1" = "Tôi đã mua và sử dụng một phần mềm PDF trả phí, nhưng giờ đây ngay cả những tính năng cơ bản cũng bị chuyển sang hình thức đăng ký. Vì quá bực mình với điều đó, tôi đã tạo ra HwattakPDF bằng Vibe Coding.";
"about.introduction.2" = "Tôi hiểu công ty đó cũng cần duy trì hoạt động và có những quyết định khó tránh khỏi. Tuy vậy, tôi cảm thấy cách làm này quá bất công với những người đã trả tiền mua phần mềm, nên tôi quyết định tự mình tạo ra một ứng dụng khác.";
"about.introduction.3" = "Tôi mong HwattakPDF sẽ giúp nhiều người sử dụng PDF một cách thuận tiện hơn.";
"about.introduction.4" = "Tôi sẽ cố gắng hết sức để HwattakPDF luôn được cung cấp và hỗ trợ miễn phí trọn đời, và chỉ nhận những khoản tip nhỏ hoàn toàn tự nguyện.";
"about.introduction.5" = "Và ERW FWS WRG";
"about.support.title" = "Nguồn động lực giúp HwattakPDF luôn miễn phí";
"about.support.detail" = "HwattakPDF không có phí đăng ký và cũng không có quảng cáo. Những khoản ủng hộ tự nguyện là nguồn hỗ trợ duy nhất giúp việc phát triển và bảo trì miễn phí có thể tiếp tục.";
"about.image_accessibility" = "Tranh nhân vật đen trắng do nhà phát triển cung cấp";
