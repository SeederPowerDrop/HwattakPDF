"help.topic.plugins.title" = "Tiện ích bổ sung";
"help.topic.plugins.summary" = "Thêm an toàn những chức năng bạn cần và quản lý quyền cùng mức sử dụng tài nguyên.";
"help.item.plugin_install.title" = "Cài đặt và quản lý";
"help.item.plugin_install.detail" = "Trên thanh menu, mở Tiện ích bổ sung > Quản lý tiện ích…, rồi chọn một gói thư mục .hwattakplugin bằng Cài đặt tiện ích…. Trước khi cài, hãy xem xét tên, tác giả, phiên bản và các quyền được yêu cầu. Sau đó, dùng công tắc để bật, tắt hoặc gỡ tiện ích.";
"help.item.plugin_permissions.title" = "Xem xét quyền tối thiểu";
"help.item.plugin_permissions.detail" = "Quyền v1 chỉ giới hạn ở thông tin tài liệu, văn bản đã chọn, bảng nhớ tạm và liên kết đã xác nhận. v2 hiển thị riêng quyền truy cập trang hiện tại, dịch thuật, YouTube hoặc bảng web. Đừng cài tiện ích yêu cầu quyền không liên quan.";
"help.item.plugin_safety.title" = "Ranh giới an toàn và tin cậy";
"help.item.plugin_safety.detail" = "Tiện ích v1 dùng mẫu đã xác thực và không truy cập trực tiếp mã tùy ý, shell, Chuỗi khóa, byte PDF thô, mạng hoặc GPU. Bảng web v2 hiển thị trang đã được xem xét trong phiên tạm thời, nhưng JavaScript từ xa, cookie, theo dõi và tài nguyên phụ vẫn có thể chạy. Chính sách điều hướng không phải trình chặn theo dõi hay tường lửa.";
"help.item.plugin_performance.title" = "Hiệu năng và khắc phục sự cố";
"help.item.plugin_performance.detail" = "Tiện ích bị giới hạn ở 32 gói cài đặt, 24 tác vụ cho mỗi tiện ích và 2 MB cho mỗi gói. Chúng chỉ chạy khi cần và không tạo tác vụ CPU hoặc GPU thông thường. Nếu ứng dụng chậm đi hoặc lỗi lặp lại, hãy tắt tiện ích, làm mới danh sách, rồi xem thông báo về gói bị cách ly hoặc gỡ tiện ích.";

