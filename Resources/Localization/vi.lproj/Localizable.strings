"help.shortcut.previous_tab" = "Tab trước";
"help.shortcut.settings" = "Mở Cài đặt";
"help.shortcut.signature_undo" = "Hoàn tác nét ký gần nhất";
"help.shortcut.compare_exit" = "Thoát so sánh hoặc hủy";
"help.shortcut.help" = "Mở hướng dẫn sử dụng này";

"help.topic.accessibility.title" = "Trợ năng và sự thoải mái";
"help.topic.accessibility.summary" = "Khám phá các điều khiển mà vẫn giữ cách hoạt động nguyên bản của Mac.";
"help.item.accessibility_labels.title" = "Chú giải công cụ và VoiceOver";
"help.item.accessibility_labels.detail" = "Di con trỏ lên biểu tượng để xem chú giải. Các điều khiển chính cung cấp tên, giá trị, trạng thái được chọn và gợi ý cho VoiceOver.";
"help.item.accessibility_keyboard.title" = "Điều khiển thuận tiện bằng bàn phím";
"help.item.accessibility_keyboard.detail" = "Dùng Tab để di chuyển giữa các điều khiển, Return để thực hiện thao tác mặc định trong hộp thoại và Escape để hủy. Các đối tượng đã thêm và đang được chọn cũng phản hồi phím mũi tên, Shift+Mũi tên, Delete và Escape.";
"help.item.accessibility_display.title" = "Tùy chọn hiển thị và nhập liệu";
"help.item.accessibility_display.detail" = "Giao diện tuân theo chế độ Sáng hoặc Tối và hỗ trợ bố cục từ phải sang trái. Nếu phím bổ trợ xung đột với Thu phóng trợ năng của macOS, hãy đổi hoặc tắt thu phóng bằng cuộn trong Cài đặt.";
"help.item.page_jump.title" = "Đi thẳng đến một trang";
"help.item.page_jump.detail" = "Nhập số từ 1 đến tổng số trang trong thanh công cụ hoặc bảng trang, rồi nhấn Return. Giá trị ngoài phạm vi sẽ không điều hướng; nhấn Escape để hủy chỉnh sửa.";
"help.item.sidebar_resize.title" = "Đổi kích thước bảng trang";
