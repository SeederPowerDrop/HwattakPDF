"help.topic.start.title" = "Bắt đầu";
"help.topic.start.summary" = "Mở PDF và làm quen với không gian làm việc chính.";
"help.item.open.title" = "Mở PDF";
"help.item.open.detail" = "Dùng biểu tượng thư mục hoặc ⌘O. Khi chọn nhiều PDF, mỗi tệp sẽ mở trong một tab riêng.";
"help.item.layout.title" = "Làm quen với màn hình";
"help.item.layout.detail" = "Thanh trên cùng quản lý không gian làm việc, tab, chế độ so sánh và tài nguyên. Thanh công cụ bên dưới điều khiển trang, chế độ xem, chỉnh sửa, OCR, AI và tìm kiếm.";
"help.item.resume.title" = "Tiếp tục công việc";
"help.item.resume.detail" = "Sau khi thoát ứng dụng theo cách thông thường, các tệp, không gian làm việc, thứ tự và ngăn xếp tab, trang đang mở, trạng thái xem và bố cục so sánh sẽ được khôi phục. Các chỉnh sửa PDF vẫn cần được lưu riêng.";

"help.topic.tabs.title" = "Tab, ngăn xếp và không gian làm việc";
"help.topic.tabs.summary" = "Sắp xếp nhiều tài liệu mà vẫn giữ nguyên trạng thái riêng của từng tài liệu.";
"help.item.tab_stack.title" = "Tạo và sắp xếp lại ngăn xếp tab";
"help.item.tab_stack.detail" = "Thả một tab vào giữa tab khác để xếp chúng thành nhóm. Thả gần mép để đổi thứ tự thay vì tạo nhóm.";
"help.item.unstack.title" = "Đưa tab ra khỏi ngăn xếp";
"help.item.unstack.detail" = "Kéo tab trong ngăn xếp đến cuối hàng tab chính để tách riêng, hoặc thả tab vào vùng tài liệu để chuyển nguyên phiên làm việc đó sang cửa sổ HwattakPDF mới.";
"help.item.workspace.title" = "Tách riêng các không gian làm việc";
"help.item.workspace.detail" = "Dùng menu có biểu tượng các ô vuông xếp chồng để tạo, đổi tên, chuyển đổi hoặc xóa không gian làm việc và di chuyển các tab liên quan cùng nhau.";
"help.item.resources.title" = "Theo dõi mức sử dụng tài nguyên";
"help.item.resources.detail" = "Biểu tượng đồng hồ đo hiển thị ước tính CPU, bộ nhớ và tải của từng tab. Các PDF không có thay đổi chưa lưu và đang không hoạt động sẽ tự động ngủ đông khi cần.";

"help.topic.view.title" = "Trang, thu phóng và điều hướng";
"help.topic.view.summary" = "Chọn bố cục đọc và di chuyển trong tài liệu một cách thoải mái.";
"help.item.page_panel.title" = "Hiển thị và đặt vị trí bảng trang";
"help.item.page_panel.detail" = "Biểu tượng bảng dùng để hiện hoặc ẩn hình thu nhỏ. Biểu tượng bốn hướng đặt bảng ở bên trái, bên phải, phía trên hoặc phía dưới.";
"help.item.page_layout.title" = "Chọn số trang cần hiển thị";
"help.item.page_layout.detail" = "Biểu tượng trang dọc hiển thị một trang. Biểu tượng có một phần cặp trang tiếp theo ở dưới bật chế độ cuộn hai trang liên tục; biểu tượng chỉ có đúng hai trang giữ nguyên cặp trang hiện tại và chuyển mỗi lần hai trang. Biểu tượng bốn trang và menu hướng điều khiển nhóm bốn trang; biểu tượng số cho phép chọn từ 1 đến 12 trang.";
"help.item.zoom_pan.title" = "Thu phóng và di chuyển";
"help.item.zoom_pan.detail" = "Chụm hai ngón để thu phóng và dùng thao tác cuộn hai ngón nguyên bản. Theo mặc định, giữ Option và cuộn để thu phóng; chế độ một và hai trang lấy vị trí con trỏ làm tâm, còn tổng quan nhiều trang lấy tâm khung nhìn làm chuẩn. Giữ Shift và cuộn dọc để di chuyển ngang. Có thể đổi phím bổ trợ thu phóng thành Command hoặc tắt trong Cài đặt.";
"help.item.thumbnails.title" = "Điều chỉnh nhóm hình thu nhỏ";
"help.item.thumbnails.detail" = "Bảng trang có thể hiển thị từng trang, cặp trang trái-phải cố định hoặc nhóm bốn trang. Dùng thanh trượt, nút cộng/trừ hoặc cử chỉ phóng đại trên bàn di chuột, và kéo hình thu nhỏ của trang thật để đổi thứ tự.";

"help.topic.compare.title" = "So sánh PDF";
"help.topic.compare.summary" = "Đọc hai đến bốn tài liệu đang mở theo chiều ngang hoặc chiều dọc.";
"help.item.compare_start.title" = "Bắt đầu so sánh";
"help.item.compare_start.detail" = "Mở ít nhất hai PDF, sau đó chọn biểu tượng các hình chữ nhật chồng nhau và chọn tài liệu.";
"help.item.compare_layout.title" = "Sắp xếp lại và đổi kích thước các bảng";
"help.item.compare_layout.detail" = "Chọn bố cục cạnh nhau hoặc xếp chồng. Kéo tiêu đề bảng để đổi thứ tự và kéo đường phân cách để điều chỉnh chiều rộng hoặc chiều cao của các bảng liền kề.";
"help.item.compare_sync.title" = "Đồng bộ hoặc khóa thao tác cuộn";
"help.item.compare_sync.detail" = "Bật đồng bộ cuộn để theo dõi tiến độ tương đối giữa các tài liệu. Khóa bảng nào cần giữ nguyên vị trí.";

"help.topic.edit.title" = "Chỉnh sửa và chú thích";
"help.topic.edit.summary" = "Thêm chú thích PDF tiêu chuẩn và quản lý trang an toàn.";
"help.item.tools.title" = "Chọn, văn bản, bút và tẩy";
"help.item.tools.detail" = "Cụm điều khiển công cụ chuyển đổi giữa chọn đối tượng, chèn văn bản tự do, vẽ mực và xóa mực. Chỉnh sửa chi tiết khả dụng trong chế độ xem một và hai trang.";
"help.item.markup.title" = "Tô sáng, ký tên và thêm hình ảnh";
"help.item.markup.detail" = "Chọn văn bản trong PDF trước khi dùng bút tô sáng. Biểu tượng chữ ký mở phần thu chữ ký bằng bàn di chuột; biểu tượng ảnh có dấu cộng đặt hình ảnh lên trang hiện tại.";
"help.item.pages.title" = "Sắp xếp các trang";
"help.item.pages.detail" = "Menu trang cho phép ghép PDF, lưu các trang đã chọn thành một PDF hoặc thành các PDF riêng, xoay hoặc xóa trang. Bạn cũng có thể chọn và kéo hình thu nhỏ để đổi thứ tự.";
"help.item.ocr.title" = "Chạy OCR cục bộ";
"help.item.ocr.detail" = "Nút OCR dùng Apple Vision trên máy Mac này, có thể tiếp tục từ điểm kiểm tra theo trang và xuất bản sao có thể tìm kiếm mà không gửi PDF đến máy chủ.";
"help.item.move_delete.title" = "Di chuyển hoặc xóa đối tượng đã thêm";
"help.item.move_delete.detail" = "Dùng công cụ Chọn để kéo văn bản, chữ ký hoặc hình ảnh đã thêm. Phím mũi tên di chuyển 1 điểm, Shift+Mũi tên di chuyển 10 điểm, Delete xóa và Escape bỏ chọn. Hình ảnh còn hỗ trợ đổi kích thước, cắt xén và điều khiển lớp.";

"help.topic.signature.title" = "Chữ ký";
"help.topic.signature.summary" = "Thu, lưu trữ và đặt một chữ ký viết tay rõ nét.";
"help.item.signature_capture.title" = "Thu chữ ký bằng bàn di chuột hoặc chuột";
"help.item.signature_capture.detail" = "Nhấn “Bắt đầu nhập bằng bàn di chuột”, rồi dùng một ngón tay chạm nhẹ để vẽ. Có thể điều chỉnh độ nhạy, độ mượt, độ rộng, tốc độ và màu; đồng thời hỗ trợ nhập bằng chuột.";
"help.item.signature_secure.title" = "Quản lý chữ ký đã lưu";
"help.item.signature_secure.detail" = "Chữ ký đã áp dụng thành công có thể được lưu trong Chuỗi khóa không đồng bộ của người dùng macOS hiện tại. Bạn có thể thay thế hoặc xóa chữ ký trong phần Quản lý chữ ký đã lưu.";
"help.item.signature_place.title" = "Đặt vị trí chữ ký";
"help.item.signature_place.detail" = "Sau khi áp dụng, công cụ Chọn sẽ được kích hoạt. Kéo chữ ký rõ nét vào ô ký và dùng các núm ở góc để đổi kích thước.";

"help.topic.ai.title" = "PDF AI";
"help.topic.ai.summary" = "Chỉ dùng AI bên ngoài sau khi đã chọn rõ nhà cung cấp, phạm vi và xác nhận đồng ý.";
"help.item.ai_setup.title" = "Kết nối nhà cung cấp";
"help.item.ai_setup.detail" = "Trong Cài đặt, chọn OpenAI, Claude, Gemini, DeepSeek, Qwen hoặc điểm cuối tùy chỉnh tương thích, chọn mô hình rồi lưu khóa API vào Chuỗi khóa.";
"help.item.ai_actions.title" = "Chọn thao tác và phạm vi";
"help.item.ai_actions.detail" = "Nút lấp lánh mở các thao tác tóm tắt, phân tích, giải bài, soạn bản nháp điền biểu mẫu, tìm PDF liên quan và nghiên cứu trên web cho văn bản đã chọn, các trang hoặc ngữ cảnh đại diện của tài liệu.";
"help.item.ai_privacy.title" = "Kiểm tra trước khi gửi";
"help.item.ai_privacy.detail" = "Trước mỗi yêu cầu, HwattakPDF hiển thị văn bản và cuộc trò chuyện sắp rời khỏi máy Mac. PDF gốc không tự động được tải lên; công cụ web và MCP phải được chủ động bật, còn lệnh gọi MCP cần được phê duyệt.";

"help.topic.save.title" = "Lưu an toàn";
"help.topic.save.summary" = "Phân biệt khi nào tệp PDF thay đổi và khi nào chỉ trạng thái không gian làm việc được ghi nhớ.";
"help.item.save_choices.title" = "Lưu thay đổi vào PDF";
"help.item.save_choices.detail" = "⌘S cho phép ghi đè bản gốc, lưu bản sao hoặc hủy. Nút Lưu sẽ được làm nổi bật khi PDF hiện tại có thay đổi chưa lưu.";
"help.item.save_copy.title" = "Lưu một bản sao riêng";
"help.item.save_copy.detail" = "⇧⌘S mở thẳng lệnh Lưu bản sao. Bản gốc được giữ nguyên và bản sao đã lưu trở thành tài liệu hiện tại không còn thay đổi chờ lưu.";
"help.item.save_close.title" = "Đóng mà không mất công việc";
"help.item.save_close.detail" = "Khi đóng tab hoặc cửa sổ có thay đổi chưa lưu, hay thoát ứng dụng, bạn sẽ được hỏi ghi đè, lưu bản sao, bỏ thay đổi hay hủy. Chọn hủy sẽ giữ tài liệu mở.";
"help.item.session_vs_pdf.title" = "Khôi phục phiên không phải là lưu PDF";
"help.item.session_vs_pdf.detail" = "Ngăn xếp tab, không gian làm việc, cửa sổ, bố cục so sánh, trang và vị trí xem được tự động ghi nhớ. Chú thích và chỉnh sửa trang chỉ được ghi vào tệp PDF sau khi bạn lưu.";

"help.topic.shortcuts.title" = "Phím tắt";
"help.topic.shortcuts.summary" = "Các lệnh thông dụng hiện đã được triển khai trong HwattakPDF.";
"help.shortcut.new_tab" = "Tab mới";
"help.shortcut.open" = "Mở PDF";
"help.shortcut.close" = "Đóng tab đang hoạt động";
