/* Help tutorial */
"help.title" = "Hướng dẫn sử dụng HwattakPDF";
"help.menu" = "Hướng dẫn sử dụng HwattakPDF";
"help.subtitle" = "Tìm hiểu biểu tượng, cử chỉ, phím tắt và quy trình xử lý tài liệu an toàn.";
"help.search" = "Tìm tính năng hoặc phím tắt";
"help.no_results.title" = "Không có kết quả";
"help.no_results.detail" = "Hãy thử tên tính năng hoặc phím tắt khác.";
"help.hover_tip" = "Mẹo: Di con trỏ lên biểu tượng bất kỳ trên thanh công cụ để xem tên và công dụng.";
