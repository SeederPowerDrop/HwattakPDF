"help.item.tab_stack.detail" = "将一个标签页拖放到另一个标签页中央可将它们组成一组；拖放到边缘附近则会调整顺序。";
"help.item.unstack.title" = "从组中取出标签页";
"help.item.unstack.detail" = "将组内标签页拖到主标签栏末端，可使其成为独立标签页；将其拖放到文档区域，则会把原有会话完整移至新的HwattakPDF窗口。";
"help.item.workspace.title" = "使用独立工作区";
"help.item.workspace.detail" = "通过叠放方块菜单创建、重命名、切换或删除工作区，并将相关标签页一并移动。";
"help.item.resources.title" = "查看资源使用情况";
"help.item.resources.detail" = "仪表图标可打开CPU、内存和各标签页负载的估算信息。未修改且不活跃的PDF会在需要时自动休眠。";

"help.topic.view.title" = "页面、缩放与导航";
"help.topic.view.summary" = "选择阅读布局，在文档中轻松移动。";
"help.item.page_panel.title" = "显示并放置页面面板";
"help.item.page_panel.detail" = "面板图标用于显示或隐藏缩略图。四向图标可将面板放在左侧、右侧、顶部或底部。";
"help.item.page_layout.title" = "选择要显示的页面数";
"help.item.page_layout.detail" = "纵向页面图标显示单页。下方露出下一组页面的图标表示连续双页滚动；只含两张完整页面的图标仅显示当前固定双页，并以两页为一组翻页。四页图标和方向菜单控制四页分组；数字图标可设置1至12页。";
"help.item.zoom_pan.title" = "缩放与平移";
"help.item.zoom_pan.detail" = "通过双指捏合缩放，并使用系统原生的双指滚动。默认情况下，按住Option并滚动可缩放；单页和双页视图以指针位置为基准，多页总览则以中心为基准。按住Shift并纵向滚动可横向平移。可在“设置”中将缩放修饰键改为Command或关闭。";
"help.item.thumbnails.title" = "调整缩略图分组";
"help.item.thumbnails.detail" = "页面面板可以按单页、固定左右双页或四页分组显示。可使用滑块、加减按钮或触控板缩放手势调整大小，并拖动实际页面缩略图来重新排序。";

"help.topic.compare.title" = "比较PDF";
"help.topic.compare.summary" = "将两至四份已打开的文档左右或上下排列阅读。";
"help.item.compare_start.title" = "开始比较";
"help.item.compare_start.detail" = "至少打开两个PDF，然后选择重叠矩形图标并选取要比较的文档。";
"help.item.compare_layout.title" = "重新排列面板并调整大小";
"help.item.compare_layout.detail" = "选择并排或上下堆叠布局。拖动面板标题可调整顺序，拖动分隔线可调整相邻面板的宽度或高度。";
"help.item.compare_sync.title" = "同步或锁定滚动";
"help.item.compare_sync.detail" = "开启滚动同步后，各文档会按相对阅读进度同步移动。可锁定需要保持不动的面板。";

"help.topic.edit.title" = "编辑与批注";
"help.topic.edit.summary" = "添加标准PDF批注并安全地管理页面。";
"help.item.tools.title" = "选择、文本、画笔和橡皮擦";
"help.item.tools.detail" = "分段式工具控件可在对象选择、自由文本插入、墨迹绘制和墨迹擦除之间切换。单页和双页视图支持详细编辑。";
"help.item.markup.title" = "高亮、签名和添加图像";
"help.item.markup.detail" = "使用高亮工具前，请先选择PDF文本。签名图标会打开触控板采集窗口，照片加号图标则会在当前页面放置图像。";
"help.item.pages.title" = "编排页面";
"help.item.pages.detail" = "页面菜单可合并PDF，将所选页面存储为一个PDF或分页PDF，还可旋转或删除页面。也可以选择并拖动缩略图来重新排序。";
"help.item.ocr.title" = "运行本地OCR";
"help.item.ocr.detail" = "OCR按钮使用这台Mac上的Apple Vision，可从页面检查点继续处理，并在不将PDF发送到服务器的情况下导出可搜索副本。";
"help.item.move_delete.title" = "移动或删除已添加的对象";
"help.item.move_delete.detail" = "使用选择工具拖动已添加的文本、签名或图像。方向键移动1点，Shift+方向键移动10点，Delete删除对象，Escape取消选择。图像还支持调整大小、裁剪和图层控制。";

"help.topic.signature.title" = "签名";
"help.topic.signature.summary" = "采集、存储并放置清晰的手写签名。";
"help.item.signature_capture.title" = "使用触控板或鼠标采集";
"help.item.signature_capture.detail" = "按下“开始触控板输入”，然后用一根手指轻触绘制。可以调整灵敏度、平滑度、宽度、速度和颜色，也可使用鼠标输入。";
"help.item.signature_secure.title" = "管理已存储的签名";
"help.item.signature_secure.detail" = "成功应用的签名可以存储在当前macOS用户不会同步的钥匙串中。可在“管理已存储的签名”中替换或删除。";
"help.item.signature_place.title" = "放置签名";
"help.item.signature_place.detail" = "应用后，选择工具会自动启用。将清晰的签名拖到签名栏中，并使用角部控制点调整大小。";

"help.topic.ai.title" = "PDF AI";
"help.topic.ai.summary" = "仅在明确指定提供商、范围并获得同意后使用外部AI。";
"help.item.ai_setup.title" = "连接提供商";
"help.item.ai_setup.detail" = "在“设置”中选择OpenAI、Claude、Gemini、DeepSeek、Qwen或兼容的自定义端点，选择模型，并将API密钥存储到钥匙串中。";
"help.item.ai_actions.title" = "选择操作和范围";
"help.item.ai_actions.detail" = "通过闪光按钮，可以针对所选文本、页面或具有代表性的文档上下文执行摘要、分析、问题求解、填写草稿、相关PDF和网页研究等操作。";
"help.item.ai_privacy.title" = "发送前检查";
"help.item.ai_privacy.detail" = "每次请求前，HwattakPDF都会显示将要离开Mac的文本和对话。原始PDF不会自动上传；网页和MCP工具需主动启用，MCP调用还需获得批准。";

"help.topic.save.title" = "安全存储";
"help.topic.save.summary" = "了解何时会更改PDF文件，以及何时只会记住工作区状态。";
"help.item.save_choices.title" = "存储PDF更改";
"help.item.save_choices.detail" = "按⌘S后可选择覆盖原文件、存储副本或取消。当前PDF有未存储的更改时，存储按钮会高亮显示。";
"help.item.save_copy.title" = "存储单独的副本";
"help.item.save_copy.detail" = "按⇧⌘S可直接打开“存储副本”。原文件会保留，存储的副本将成为当前无未存储更改的文档。";
"help.item.save_close.title" = "关闭时不丢失工作";
"help.item.save_close.detail" = "关闭有未存储更改的标签页、窗口或应用时，系统会询问是覆盖、存储副本、丢弃还是取消。选择取消会让文档保持打开。";
